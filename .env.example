# ---------------------------------------------------------------------------
# Wellness House — backend environment variables.
#
# You usually DON'T need this file: the defaults below work as-is with
# XAMPP, Laragon, AND Docker (all use root / empty password / port 3306).
# Copy to ".env" only to override something. START.sh / START.ps1 auto-load it.
#
# .NET maps "__" to nested config:
#   ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection
# ---------------------------------------------------------------------------

# MySQL/MariaDB connection. The app auto-detects the engine + version, so the
# SAME string works whether you run XAMPP (MariaDB), Laragon (MySQL/MariaDB),
# or Docker (MySQL). Just make sure a database named "wellnessdb" exists.
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=wellnessdb;User=root;Password=;

# JWT signing key. REQUIRED — the API won't start without a real key (>=32 chars).
Jwt__Key=WellnessHouseDevelopmentJwtSigningKey_ChangeBeforeProduction_2026

# ASP.NET Core runtime settings.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5077

# Email (SMTP) — appointment reminders / notifications. Mailtrap sandbox placeholders.
Email__Host=sandbox.smtp.mailtrap.io
Email__Port=587
Email__Username=your_mailtrap_user
Email__Password=your_mailtrap_password
Email__From=noreply@wellnesshouse.com
